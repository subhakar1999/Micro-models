# Documentation only: copy values into your shell or container environment.
MICRO_TASK=text
MICRO_PROFILE_PATH=profiles/text.json
MICRO_TEXT_BACKEND=gguf
MICRO_THREADS=1
MICRO_DATA_DIR=data
MICRO_MAX_UPLOAD_BYTES=10485760
MICRO_MAX_AUDIO_SECONDS=60
MICRO_MAX_DOCUMENT_PAGES=8
# For local/external access, set a key. Cloud Run IAM recipe leaves this unset.
MICRO_API_KEY=
MICRO_TEXT_URL=http://127.0.0.1:8080/v1
